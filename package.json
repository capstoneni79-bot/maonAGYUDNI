{
  "name": "hinunangan-swine-registry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --minify --outfile=api/index.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist api/index.js api/index.js.map",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "d3-color": "^3.1.0",
    "d3-delaunay": "^6.0.4",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.66.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "shpjs": "^6.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "core-js@3.50.0": true,
    "@google/genai@2.24.0": true
  }
}
